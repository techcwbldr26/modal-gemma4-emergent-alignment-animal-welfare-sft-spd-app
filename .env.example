# Your Modal account credentials (`modal token new`; `modal profile current` to verify)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=main

# HuggingFace token (Xet transfer backend) — Gemma 4 is gated; also needs
# the Gemma license accepted on the account.
HF_TOKEN=

# Ollama Cloud API key (teacher/judge models — open-source-only policy):
#   glm-5.3-flash + deepseek-v4-flash:0731 via https://ollama.com/api/chat
OLLAMA_API_KEY=

# Endpoints (filled after deploys)
DIRECTOR_URL=
