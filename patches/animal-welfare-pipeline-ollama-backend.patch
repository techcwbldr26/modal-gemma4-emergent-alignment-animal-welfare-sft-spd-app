+def _call_ollama(
+    model: str,
+    system: str,
+    user_message: str,
+    max_tokens: int,
+    temperature: float,
+    return_stop_reason: bool,
+    stage: str | None,
+    item_id: str | None,
+    started: float,
+) -> str | tuple[str, str | None]:
+    """Ollama Cloud backend (https://ollama.com/api/chat) — open-source-only policy.
+
+    Maps the call_claude contract onto Ollama's chat API: system prompt as a
+    system message, thinking disabled (the pipeline's prompts are
+    reasoning-explicit; thinking doubles latency/cost and changes the output
+    contract), num_predict as the max_tokens cap, done_reason mapped to
+    end_turn/max_tokens stop reasons.
+    """
+    import urllib.request
+
+    messages = []
+    if system:
+        messages.append({"role": "system", "content": system})
+    messages.append({"role": "user", "content": user_message})
+    body = json.dumps({
+        "model": model,
+        "messages": messages,
+        "stream": False,
+        # NOTE: do NOT send think:false — glm-5.3-flash has reasoning always on,
+        # and forcing think:false makes it emit reasoning INTO the content field.
+        # Default behavior separates reasoning into message.thinking (dropped).
+        "options": {"temperature": temperature, "num_predict": max_tokens},
+    }).encode()
+    req = urllib.request.Request(
+        "https://ollama.com/api/chat",
+        data=body,
+        headers={
+            "Authorization": "Bearer " + os.environ["OLLAMA_API_KEY"],
+            "Content-Type": "application/json",
+        },
+    )
+    resp = json.loads(urllib.request.urlopen(req, timeout=600).read())
+    text = (resp.get("message", {}).get("content") or "").strip()
+    stop = "max_tokens" if resp.get("done_reason") == "length" else "end_turn"
+    _log_usage(
+        model,
+        resp.get("prompt_eval_count") or 0,
+        resp.get("eval_count") or 0,
+        stage=stage,
+        item_id=item_id,
+        duration_s=time.monotonic() - started,
+        attempts=1,
+        backend="ollama",
+    )
+    if stop != "end_turn":
+        print(
+            f"  WARNING: response stop_reason={stop!r} (model {model}, backend ollama) "
+            "— output may be truncated.",
+            file=sys.stderr,
+        )
+    return (text, stop) if return_stop_reason else text
+
